# Copy this file to .env and fill in your own keys.
# .env itself is gitignored — never commit real values.

# --- MCQ generation (generate_mcq.py) — shares GEMINI_API_KEY and
# OPENAI_API_KEY below with the matching evaluation scripts. Pick which LLM
# generates with `python generate_mcq.py --llm gemini` or `--llm gpt`.

# --- Evaluation (evaluation/) and generation — one block per model ---

# Gemini (generate_mcq.py --llm gemini, evaluation/gemini_evaluation.py)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (generate_mcq.py --llm gpt, evaluation/openai_evaluation.py)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5

# Cohere (evaluation/cohere_evaluation.py)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

# Perplexity (evaluation/perplexity_evaluation.py)
PPLX_API_KEY=your_perplexity_api_key_here
PPLX_MODEL=sonar

# Mistral (evaluation/mistral_evaluation.py)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# Together AI — powers both Llama 4 and DeepSeek-R1 (batch API)
TOGETHER_API_KEY=your_together_api_key_here
LLAMA4_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-R1
